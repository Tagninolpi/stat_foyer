library(coda)
library(rjags)
setwd("C:/Users/manch//Desktop/M2 Bioinfo/Stats/PROJET")
df <- read.table("2021_05_14_full_database_2doses.txt")
df
colnames(df) <- c(
"individual_id",
"house_id",
"household_size",
"date_symptom",
"infection_status",
"vaccination_status",
"end_follow_up",
"age",
"index_cases",
"isolation_status"
)
dim(df)
names(df)
head(df)
tail(df)
df$infected <- ifelse(df$infection_status == 0, 0, 1)
df$infected <- ifelse(df$infection_status == 0, 0, 1)
df <- subset(df, index_cases == 0 & vaccination_status != -1)
dim(df)
df
df$vaccinated <- df$vaccination_status
dim(df)
names(df)
N <- nrow(df)
N
model_M0 <- "model {
a ~ dnorm(0, 0.16)
b ~ dnorm(0, 0.16)
for (i in 1:N) {
logit(p[i]) <- a + b * vaccinated[i]
infected[i] ~ dbern(p[i])
}
}"
data_M0 <- list(N = N, infected = df$infected, vaccinated = df$vaccinated)
# Creation du sampler
model_jags0 <- jags.model(
textConnection(model_M0),
data = data_M0,
n.chains = 3
)
# le burnin pour que les valeurs convergent: les premieres
# iterations de la chaine MCMC ne sont pas conservées
update(model_jags0, 2000)
# mcmc sample
samples0 <- coda.samples(
model_jags0,
variable.names = c("a", "b"),
n.iter = 10000
)
summary(samples0)
gelman.diag(samples0)
effectiveSize(samples0)
plot(samples0)
autocorr.plot(samples0)
post0[, "a"],
hist(
post0[, "b"],
breaks = 50,
main = "M0 - Posterior de b",
xlab = "b",
col = "lightblue"
)
post0 <- as.matrix(samples0)
hist(
post0[, "a"],
breaks = 50,
main = "M0 - Posterior de a",
xlab = "a",
col = "lightblue"
)
hist(
post0[, "b"],
breaks = 50,
main = "M0 - Posterior de b",
xlab = "b",
col = "lightblue"
)
# Personnes non protegees
p0_non_vaccinated <- plogis(post0[, "a"]) # transforme le logit en proba
mean(p0_non_vaccinated)
quantile(p0_non_vaccinated, c(0.025, 0.5, 0.975))
# Personnes protegees
p0_vaccinated <- plogis(post0[, "a"] + post0[, "b"])
mean(p0_vaccinated)
quantile(p0_vaccinated, c(0.025, 0.5, 0.975))
hist(
p0_non_vaccinated,
breaks = 50,
main = "M0 - Probabilite d'infection : non proteges",
xlab = "Probabilite d'infection",
col = "lightblue"
)
hist(
p0_vaccinated,
breaks = 50,
main = "M0 - Probabilite d'infection : proteges",
xlab = "Probabilite d'infection",
col = "lightblue"
)
observed0 <- aggregate(
infected ~ vaccinated,
data = df,
FUN = mean
)
print(observed0)
names(observed0)[2] <- "observed_p"
profiles0 <- data.frame(
vaccinated = c(0, 1),
mean_p = c(
mean(p0_non_vaccinated),
mean(p0_vaccinated)
),
lower_95 = c(
quantile(p0_non_vaccinated, 0.025),
quantile(p0_vaccinated, 0.025)
),
upper_95 = c(
quantile(p0_non_vaccinated, 0.975),
quantile(p0_vaccinated, 0.975)
)
)
comparison0 <- merge(
observed0,
profiles0,
by = "vaccinated"
)
comparison0
# beside pour afficher les barres d'un même groupe côte à côte
barplot(
rbind(comparison0$observed_p, comparison0$mean_p),
beside = TRUE,
names.arg = c("Non proteges", "Proteges"),
col = c("blue", "orange"),
ylim = c(0, 1),
ylab = "Probabilite d'infection",
main = "M0 - Observe vs predit"
)
legend(
"topright",
legend = c("Observe", "Predit"),
fill = c("blue", "orange")
)
donnees <- read.table(file.choose(), header = FALSE)
# Donner un nom à chaque des 10 colonnes
names(donnees) <- c(
"id", "foyer", "taille_foyer", "jour_infection",
"statut_infection", "statut_vaccinal", "fin_suivi",
"classe_age", "index_contact", "isolement"
)
# vérif les colonnes
head(donnees)
# regrouper le status d'infecton (nouvelle colonne)
donnees$infecte <- ifelse(donnees$statut_infection == 0, 0, 1)
# verif
table(donnees$statut_infection, donnees$infecte)
# voir infections antérieures
contacts <- subset(donnees, index_contact == 0)
table(contacts$statut_vaccinal)
analyse <- subset(contacts, statut_vaccinal != -1)
with(analyse, table(statut_vaccinal, infecte))
data_jags <- list(
N = nrow(analyse),
infecte = analyse$infecte,
vacc = analyse$statut_vaccinal,
taille_foyer = analyse$taille_foyer
)
modele <- "model {
a ~ dnorm(0,0.16)
b ~ dnorm(0,0.16)
c ~ dnorm(0,0.16)
for (i in 1:N) {
logit(p[i]) <- a + b*vacc[i] + c*taille_foyer[i]
infecte[i] ~ dbern(p[i])
}
}"
modele <- "model {
a ~ dnorm(0,0.16)
b ~ dnorm(0,0.16)
c ~ dnorm(0,0.16)
for (i in 1:N) {
logit(p[i]) <- a + b*vacc[i] + c*(taille_foyer[i]-1)
infecte[i] ~ dbern(p[i])
}
}"
library(rjags)
library(coda)
init <- list(
list(a = 0,  b = 0,  c = 0),
list(a = -1, b = -1, c = 0.1),
list(a = 1,  b = 1,  c = -0.1)
)
# Fixer générateur
set.seed(123)
# Coefficients fictifs choisis pour le test
a_vrai <- -0.5
b_vrai <- -1
c_vrai <- 0.1
# Probabilité d'infection pour chaque contact
p_sim <- plogis(
a_vrai +
b_vrai * analyse$statut_vaccinal +
c_vrai * analyse$taille_foyer
)
# Simuler le statut infection de chaque contact
infecte_sim <- rbinom(
n = nrow(analyse),
size = 1,
prob = p_sim
)
table(infecte_sim)
# Préparer les données simulées
data_sim <- list(
N = nrow(analyse),
infecte = infecte_sim,
vacc = analyse$statut_vaccinal,
taille_foyer = analyse$taille_foyer
)
# Ajuster le modèle aux infections simulées
modele_sim <- jags.model(
file = textConnection(modele),
data = data_sim,
inits = init,
n.chains = 3,
n.adapt = 1000
)
# Écarter les 5k premières itérations
update(modele_sim, n.iter = 5000)
# Conserver les tirages des coefficients
tirages_sim <- coda.samples(
model = modele_sim,
variable.names = c("a", "b", "c"),
n.iter = 10000
)
# Examiner les chaînes et les estimations
plot(tirages_sim)
gelman.diag(tirages_sim, multivariate = FALSE)
effectiveSize(tirages_sim)
summary(tirages_sim)
modele_jags <- jags.model(
file = textConnection(modele),
data = data_jags,
inits = init,
n.chains = 3,
n.adapt = 1000
)
update(modele_jags, n.iter = 5000)
tirages <- coda.samples(
model = modele_jags,
variable.names = c("a", "b", "c"),
n.iter = 10000
)
plot(tirages)
gelman.diag(tirages, multivariate = FALSE)
effectiveSize(tirages)
summary(tirages) #Résumer le posterior de chaque coefficient
echantillons <- as.matrix(tirages) #Regrouper les tirages des trois chaînes dans une matrice
mean(echantillons[, "b"] < 0) #Estimer la probabilité a posteriori que b soit négatif : vaccination associée à une probabilité d'infection plus faible, à taille de foyer identique
mean(echantillons[, "c"] > 0) # Estimer la probabilité a posteriori que c soit positif : taille du foyer associée à une probabilité d'infection plus élevée, à statut vaccinal identique
donnees <- read.table(file.choose(), header = FALSE)
